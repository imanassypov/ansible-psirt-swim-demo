# Auto-start the self-hosted Actions runner when entering this directory.
# Must return immediately — direnv blocks the shell until .envrc exits.
# Requires: brew install direnv && direnv allow
if [[ -x scripts/ensure-actions-runner.sh ]]; then
  ( scripts/ensure-actions-runner.sh --quiet </dev/null >/dev/null 2>&1 & )
fi

# Put the project venv first on PATH. Without this, `ansible-playbook` resolves
# to the pyenv shim for .python-version, whose interpreter has ansible but not
# catalystcentersdk — and static_inventory.yml runs modules under
# ansible_playbook_python, so the CatC modules fail with "SDK is not installed".
# Mirrors ci_activate_lab_env() in scripts/ci/lib/log.sh.
if [[ -d "${PWD}/.venv" ]]; then
  export VIRTUAL_ENV="${PWD}/.venv"
  PATH_add "${PWD}/.venv/bin"
fi
