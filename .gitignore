# Secrets — never commit
.vault_pass
**/vault.yml
.env

# Non-secret but host-specific
ansible/inventory/group_vars/image_servers/vars.yml

# Runtime logs and local evidence (SWIM / CatC)
ansible/logs/
!ansible/logs/.gitkeep
logs/
*.log

# Ansible local state
ansible/.ansible/

# Python / OS
# .venv* also covers rollback copies such as .venv.bak from a Python upgrade
.venv*/
__pycache__/
.DS_Store

# Self-hosted GitHub Actions runner (local install — never commit)
.github/actions-runner/
